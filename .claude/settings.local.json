{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook post-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook pre-compact",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "Bash|bash"
      },
      {
        "hooks": [
          {
            "command": "nebu-ctx hook redirect",
            "type": "command"
          }
        ],
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "nebu-ctx hook user-prompt-submit",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}